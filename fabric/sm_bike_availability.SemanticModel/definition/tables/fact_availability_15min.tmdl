table fact_availability_15min
	lineageTag: 5d905fe1-eefe-56dc-b2f4-f7b6fbd6a8ad

	/// Station observations (one per station per minute)
	measure 'Observations' = SUM ( fact_availability_15min[polls] )
		formatString: #,0
		lineageTag: 976ec700-52dd-5d64-a0ce-20de0090020d

	/// Minutes a station had no bikes
	measure 'Minutes empty' = SUM ( fact_availability_15min[minutes_empty] )
		formatString: #,0
		lineageTag: 49dcbffe-12d5-5dfb-879e-35c157583bd8

	/// Minutes a station had no free docks
	measure 'Minutes full' = SUM ( fact_availability_15min[minutes_full] )
		formatString: #,0
		lineageTag: c7337817-92f8-54c4-9c7e-a1d355345371

	/// Share of observed minutes with no bikes
	measure 'Empty share' = DIVIDE ( [Minutes empty], [Observations] )
		formatString: 0.0%
		lineageTag: 0283189a-6033-54e0-8cb2-717b5584226d

	/// Bikes / (bikes + free docks), weighted by observations
	measure 'Avg fill rate' = DIVIDE ( SUMX ( fact_availability_15min, fact_availability_15min[avg_fill_rate] * fact_availability_15min[polls] ), SUMX ( FILTER ( fact_availability_15min, NOT ISBLANK ( fact_availability_15min[avg_fill_rate] ) ), fact_availability_15min[polls] ) )
		formatString: 0.0%
		lineageTag: d89d40c8-a17d-57fb-890d-51c0041e2490

	/// Average trips per day starting at the selected stations in the latest month of medallion fact_trips (bridge: short_name)
	measure 'Avg daily trip starts' = VAR keys = VALUES ( dim_station[trips_station_key] ) VAR latest = CALCULATE ( MAX ( fact_trips[date_key] ), REMOVEFILTERS () ) RETURN CALCULATE ( DIVIDE ( COUNTROWS ( fact_trips ), DISTINCTCOUNT ( fact_trips[date_key] ) ), REMOVEFILTERS ( dim_date ), fact_trips[date_key] > INT ( latest / 100 ) * 100, TREATAS ( keys, fact_trips[start_station_key] ) )
		formatString: #,0.0
		lineageTag: fdb40fe2-94ab-5226-8a39-33ce55e6282d

	/// Historic daily demand x current share of empty minutes: trips likely missed per day
	measure 'Starts at risk per day' = [Avg daily trip starts] * [Empty share]
		formatString: #,0.0
		lineageTag: 32fb52d5-0c50-5955-bd86-05ad4bda8e29

	column station_id
		dataType: string
		isHidden
